<?xml version="1.0" encoding="utf-8"?>
<!-- Ajustes avanzados de vídeo. Los cambia el móvil o el escritorio (CONFIG); se aplican en vivo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/advanced"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="32dp"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="Ajustes avanzados" />

    <TextView
        android:id="@+id/adv_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="13sp" />

    <Switch
        android:id="@+id/adv_front"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Cámara frontal" />

    <Switch
        android:id="@+id/adv_stab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Estabilización" />

    <TextView
        android:id="@+id/adv_zoom_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Zoom: 1.0x" />

    <SeekBar
        android:id="@+id/adv_zoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Switch
        android:id="@+id/adv_af"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Autoenfoque" />

    <TextView
        android:id="@+id/adv_focus_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Enfoque manual" />

    <SeekBar
        android:id="@+id/adv_focus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
